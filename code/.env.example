# PostgreSQL runtime configuration for resources/compose/docker-compose.yml.
# These credentials are for local development only; use deployment-managed
# secrets and connection details in every other environment.
DATABASE_HOST=localhost
DATABASE_PORT=55435
DATABASE_NAME=evalscore
DATABASE_USER=postgresqldba
DATABASE_PASSWORD=admin

# OIDC/JWKS access-token validation
AUTH_ISSUER=https://issuer.example
AUTH_AUDIENCE=evalscore
AUTH_JWKS_URL=https://issuer.example/.well-known/jwks.json
AUTH_JWKS_CACHE_SECONDS=300

# Durable worker polling interval
WORKER_IDLE_POLL_SECONDS=1

# Named LiteLLM profiles are JSON maps. DeepEval passes the selected evaluator
# profile to its LiteLLM integration; use an evaluator model such as
# openai/gpt-4.1-mini. A LiteLLM target uses the same profile map.
# api_base is the LiteLLM Gateway root, without /v1. Evalscore checks
# {api_base}/v1/models before suite creation, updates, and run execution.
# Keep real credentials in the deployment secret store.
PROVIDERS_LITELLM_PROFILES={"corporate-gateway":{"api_key":"replace-with-a-runtime-secret","api_base":"https://litellm.internal.example"},"local-gateway":{"api_key":"replace-with-a-runtime-secret","api_base":"http://localhost:4000"}}
PROVIDERS_HTTP_TARGET_PROFILES={"target":{"endpoint":"https://target.example/evaluate"}}
